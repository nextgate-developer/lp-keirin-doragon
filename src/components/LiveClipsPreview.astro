---
import preview from '../data/youtube.json';
const {variant='home',limit=3}=Astro.props;
const isArchive=variant==='archive';
const listId=isArchive?'archive-clips-list':'live-clips-list';
const videos=preview.videos.filter(video=>video.id!==preview.promotion.id).sort((a,b)=>b.publishedAt.localeCompare(a.publishedAt)).slice(0,limit);
const date=new Intl.DateTimeFormat('ja-JP',{year:'numeric',month:'2-digit',day:'2-digit',timeZone:'Asia/Tokyo'});
---
<section class:list={['live-clips','section',{'clips-archive':isArchive}]} id={isArchive?'archive-clips':'live-clips'} aria-labelledby={isArchive?'archive-clips-title':'live-clips-title'} data-track-placement={isArchive?'archive_youtube_videos':'top_youtube_videos'}>
  <div class="clips-panel">
    {isArchive&&<h2 id="archive-clips-title">ライブの魅力を切り抜きで</h2>}
    {!isArchive&&<header class="clips-header">
      <p class="clips-eyebrow"><span class="clips-youtube" aria-hidden="true">▶</span> YouTube <span class="clips-free">無料公開中</span></p>
      <h2 id="live-clips-title"><span>レジェンドたちの素顔を、</span><span>ちょっとだけ。</span></h2>
      <p class="clips-intro">笑い話も、ここだけの本音も。<br class="clips-mobile-break"/>実際の配信の雰囲気をのぞいてみよう！</p>
    </header>}
    <div class:list={['clips-navigation',{'clips-navigation-archive':isArchive}]}>
      <p class="clips-swipe">{isArchive?'横に送って、ほかの動画も見る':'左右にスワイプして見る'} <span aria-hidden="true">↔</span></p>
      {isArchive&&<div class="clip-scroll-buttons">
        <button type="button" class="clip-scroll-button" data-clip-scroll="-1" aria-controls={listId} aria-label="前の動画を表示">←</button>
        <button type="button" class="clip-scroll-button" data-clip-scroll="1" aria-controls={listId} aria-label="次の動画を表示">→</button>
      </div>}
    </div>
    <ul class="clips-grid" id={listId} tabindex={isArchive?0:undefined} aria-label={`公開中の動画${videos.length}本`}>
      {videos.map(video=><li class="clip-card" data-clip-id={video.id} data-track-video-id={video.id} data-track-video-title={video.title} data-track-video-kind="youtube_video">
        <div class="clip-media">
          <button type="button" class="clip-poster" data-track-video-action="open" data-archive-player-src={`https://www.youtube-nocookie.com/embed/${video.id}?autoplay=0&rel=0`} data-archive-player-type="iframe" data-archive-player-title={video.title} aria-label={`${video.title}のプレーヤーを開く`}>
            <span class="clip-fallback" aria-hidden="true"><span>競輪ドラゴン</span><small>YouTubeで公開中</small></span>
            <img class:list={['clip-thumbnail',{'clip-landscape':!video.videoUrl.includes('/shorts/')}]} src={video.thumbnailUrl} width="480" height="360" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer"/>
            <span class="clip-shade" aria-hidden="true"></span>
            <span class="clip-category">YouTube公開動画</span>
            <span class="clip-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 5 20 12 9 19Z" fill="currentColor"/></svg></span>
            <span class="clip-watch">動画を見る <span aria-hidden="true">▶</span></span>
          </button>
        </div>
        <div class="clip-copy">
          <p class="clip-date"><time datetime={video.publishedAt}>{date.format(new Date(video.publishedAt))}</time> 公開</p>
          <h3><a data-track-video-action="external" href={video.videoUrl} target="_blank" rel="noopener noreferrer" aria-label={`${video.title}をYouTubeで見る（別タブ）`}>{video.title.replace(/【競輪ドラゴン】$/,'')}</a></h3>
        </div>
      </li>)}
    </ul>
    <footer class="clips-footer">
      <p>この続きも、YouTubeで。</p>
      <a class="clips-channel" data-link="youtube" href={preview.channelUrl} target="_blank" rel="noopener noreferrer">ほかの動画も見る <span aria-hidden="true">↗</span><span class="clips-sr-only">（YouTube・別タブ）</span></a>
    </footer>
  </div>
</section>

<script>
  // Keep a readable poster and the play button if YouTube's thumbnail is unavailable.
  document.querySelectorAll<HTMLImageElement>('.clip-thumbnail').forEach(img=>{
    const fallback=()=>{img.hidden=true;};
    img.addEventListener('error',fallback,{once:true});
    if(img.complete&&!img.naturalWidth)fallback();
  });
  document.querySelectorAll<HTMLElement>('.clips-navigation-archive').forEach(nav=>{
    const grid=nav.closest('section')?.querySelector<HTMLElement>('.clips-grid');
    const previous=nav.querySelector<HTMLButtonElement>('[data-clip-scroll="-1"]');
    const next=nav.querySelector<HTMLButtonElement>('[data-clip-scroll="1"]');
    if(!grid||!previous||!next)return;
    const update=()=>{previous.disabled=grid.scrollLeft<=1;next.disabled=grid.scrollLeft+grid.clientWidth>=grid.scrollWidth-2;};
    [previous,next].forEach(button=>button.addEventListener('click',()=>{
      const card=grid.querySelector<HTMLElement>('.clip-card');
      const step=(card?.getBoundingClientRect().width||grid.clientWidth)+parseFloat(getComputedStyle(grid).columnGap||'0');
      grid.scrollBy({left:Number(button.dataset.clipScroll)*step,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
    }));
    grid.addEventListener('scroll',update,{passive:true});
    window.addEventListener('resize',update);
    update();
  });
</script>

<style>
  .clips-panel{position:relative;overflow:hidden;padding:40px 36px 32px;border:2px solid #fcd00b;border-radius:var(--radius);background:#fdfce5;color:#061c5b;box-shadow:0 8px 0 #0003}
  .clips-panel::before{content:"";position:absolute;inset:0 0 auto;height:7px;background:#fcd00b}
  .clips-header{text-align:center}
  .clips-eyebrow{display:flex;align-items:center;justify-content:center;gap:9px;font-size:15px;font-weight:800;letter-spacing:.025em}
  .clips-youtube{display:grid;place-items:center;width:28px;height:21px;padding-left:2px;border-radius:6px;background:#d62626;color:white;font-size:13px}
  .clips-free{padding:3px 10px;border:1px solid #061c5b30;border-radius:99px;font-size:12px;letter-spacing:0}
  h2{margin:15px 0 12px;font-size:clamp(24px,3.4cqw,38px);font-weight:900;letter-spacing:.02em;line-height:1.45}
  h2 span{display:inline-block}
  .clips-intro{font-size:15px;font-weight:700;line-height:1.9}
  .clips-mobile-break{display:none}
  .clips-grid{display:grid;grid-template-columns:repeat(3,minmax(0,248px));justify-content:center;gap:22px;list-style:none;margin:28px 0 0;padding:0}
  .clip-card{min-width:0;overflow:hidden;border:1px solid #061c5b20;border-radius:14px;background:#fff;box-shadow:0 4px 12px #061c5b0a}
  .clip-media{position:relative;aspect-ratio:9/16;overflow:hidden;background:#061c5b}
  .clip-media :global(iframe){display:block;width:100%;height:100%;border:0}
  .clip-poster{position:absolute;inset:0;display:block;width:100%;height:100%;padding:0;border:0;background:#061c5b;color:#fff;font:inherit;cursor:pointer;text-align:left}
  .clip-poster:focus-visible{outline:4px solid #fcd00b;outline-offset:-5px}
  .clip-fallback{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:radial-gradient(ellipse at top,#087eac,transparent),#061c5b;color:#fcd00b;font-size:20px;font-weight:900}
  .clip-fallback small{font-size:12px;font-weight:700;color:white}
  .clip-thumbnail{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;transition:transform .25s}
  .clip-thumbnail[hidden]{display:none}
  .clip-thumbnail.clip-landscape{object-fit:contain;background:#061c5b}
  .clip-shade{position:absolute;inset:0;background:linear-gradient(180deg,#0003,transparent 30%,transparent 60%,#000b)}
  .clip-category{position:absolute;top:12px;left:12px;padding:4px 9px;border:1px solid #ffffff80;border-radius:6px;background:#061c5bbf;color:white;font-size:11px;font-weight:800}
  .clip-play{position:absolute;top:50%;left:50%;display:grid;place-items:center;width:58px;height:58px;transform:translate(-50%,-50%);border:2px solid #fff;border-radius:50%;background:#061c5b9c;color:white;box-shadow:0 3px 16px #0003}
  .clip-play svg{width:29px;height:29px}
  .clip-watch{position:absolute;right:0;bottom:18px;left:0;display:flex;align-items:center;justify-content:center;gap:10px;font-size:14px;font-weight:800}
  .clip-watch span{color:#fcd00b;font-size:11px}
  .clip-poster:hover .clip-thumbnail{transform:scale(1.025)}
  .clip-copy{padding:14px 15px 18px}
  .clip-date{margin-bottom:6px;color:#59657b;font-size:11px;font-weight:700}
  h3{font-size:14px;font-weight:800;line-height:1.8;overflow-wrap:anywhere}
  h3 a:hover{text-decoration:underline;text-underline-offset:3px}
  h3 a:focus-visible,.clips-channel:focus-visible{outline-color:#061c5b}
  .clips-footer{display:flex;align-items:center;justify-content:center;gap:22px;margin-top:28px}
  .clips-footer p{font-size:13px;font-weight:700}
  .clips-channel{display:inline-flex;align-items:center;justify-content:center;gap:18px;min-height:46px;padding:10px 22px;border:2px solid #061c5b;border-radius:99px;background:#061c5b;color:white;font-size:14px;font-weight:800;transition:background .2s}
  .clips-channel:hover{background:#12417c}
  .clips-channel>span[aria-hidden]{color:#fcd00b;font-size:18px}
  .clips-swipe{display:none}
  .clips-archive{margin-top:24px}
  .clips-archive .clips-panel{padding:28px 24px 24px;box-shadow:none}
  .clips-archive h2{margin:0 0 20px;font-size:clamp(20px,2.4vw,28px);line-height:1.5;letter-spacing:0;text-align:left}
  .clips-navigation-archive{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}
  .clips-navigation-archive .clips-swipe{display:block;margin:0;color:#59657b;font-size:12px;font-weight:700}
  .clip-scroll-buttons{display:flex;gap:8px;flex-shrink:0}
  .clip-scroll-button{display:grid;place-items:center;width:42px;height:42px;border:1px solid #061c5b30;border-radius:50%;background:#061c5b;color:white;font:inherit;font-size:20px;cursor:pointer}
  .clip-scroll-button:disabled{background:transparent;color:#061c5b50;cursor:default}
  .clip-scroll-button:focus-visible,.clips-grid:focus-visible{outline:3px solid #061c5b;outline-offset:3px}
  .clips-archive .clips-grid{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:248px;justify-content:start;gap:20px;margin:0;padding:0 0 12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:#061c5b50 transparent;overscroll-behavior-x:contain}
  .clips-archive .clip-card{scroll-snap-align:start}
  .clips-sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  @media(max-width:767px){
    .clips-panel{padding:29px 18px 25px}
    .clips-archive .clips-panel{padding:18px 15px 22px}
    .clips-navigation-archive .clips-swipe{font-size:10px;line-height:1.6}
    .clip-scroll-button{width:38px;height:38px}
    .clips-archive .clips-grid{grid-auto-columns:76%;gap:14px}
    .clips-eyebrow{gap:7px;font-size:13px}
    .clips-free{font-size:10px;padding:3px 8px}
    h2{margin:16px -4px 12px;font-size:clamp(21px,5.9vw,29px);line-height:1.55;letter-spacing:0}
    h2 span{display:block}
    .clips-intro{font-size:12px;line-height:1.9}
    .clips-mobile-break{display:block}
    .clips-swipe{display:block;margin-top:20px;color:#59657b;font-size:10px;font-weight:700;text-align:right}
    .clips-swipe span{margin-left:5px;font-size:14px}
    .clips-grid{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:76%;justify-content:start;gap:14px;margin:8px -6px 0;padding:0 6px 12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:#061c5b50 transparent;overscroll-behavior-x:contain}
    .clip-card{scroll-snap-align:start;border-radius:12px}
    .clip-category{top:10px;left:10px;font-size:10px}
    .clip-copy{padding:12px 13px 15px}
    h3{font-size:13px;line-height:1.75}
    .clips-footer{flex-direction:column;gap:10px;margin-top:20px}
    .clips-footer p{font-size:12px}
    .clips-channel{width:100%;max-width:295px;font-size:13px}
  }
  @media(prefers-reduced-motion:reduce){.clip-thumbnail,.clips-channel{transition:none}.clip-poster:hover .clip-thumbnail{transform:none}}
</style>
