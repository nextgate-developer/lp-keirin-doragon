---
import Base from '../../layouts/Base.astro';
import PageFooter from '../../components/PageFooter.astro';
import BroadcastSchedule from '../../components/BroadcastSchedule.astro';
import { topics } from '../../lib/data.mjs';
export function getStaticPaths(){return topics.map(topic=>({params:{slug:topic.slug},props:{topic}}));}
const { topic }=Astro.props;
const facts=[topic.facts.find(f=>f.label==='開催日数'),{label:'競輪場',value:topic.venue},{label:'グレード',value:topic.grade},...topic.facts.filter(f=>f.label!=='開催日数'),{label:'配信本数',value:topic.sessions.length+'本'}].filter(Boolean);
---
<Base title={`${topic.title}｜競輪ドラゴン`} description={`${topic.title}（${topic.venue}競輪場）のオンライン配信予定。配信日時と各回のゲストをご確認いただけます。`} bodyClass="topics-page">
  <a class="skip-link" href="#main-content">本文へ進む</a>
  <div class="news-shell"><main id="main-content">
    <nav class="breadcrumbs" aria-label="パンくず"><a href="/">トップ</a><span aria-hidden="true">/</span><a href="/topics.html">配信予定・トピック一覧</a></nav>
    <article class="topic-detail">
      <div class="topic-meta"><span class="category">{topic.category}</span><span class="grade">{topic.grade}</span><span>{topic.venue}競輪場</span></div>
      <h1>{topic.title}</h1>
      <BroadcastSchedule topic={topic}/>
      <dl class="race-facts">{facts.map(f=><div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
      {topic.note && <aside class="source-note"><h2>配信計画の注記</h2><p>{topic.note}</p></aside>}
      <a class="back-to-list" href="/topics.html">← 配信予定・トピック一覧へ戻る</a>
    </article>
  </main><PageFooter/></div>
</Base>
