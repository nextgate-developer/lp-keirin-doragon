{
  "name": "keirin-dragon-lp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync:youtube": "node scripts/update-youtube.mjs",
    "dev": "node scripts/prepare-public.mjs && astro dev --host 127.0.0.1",
    "validate": "node scripts/validate.mjs",
    "build": "npm run validate && node scripts/prepare-public.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test && node scripts/verify-build.mjs && node scripts/verify-propagation.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "playwright": "^1.56.0"
  }
}
